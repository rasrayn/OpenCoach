# Local development example. Copy to .env and replace values locally.
# Never commit real secrets or private key material.

PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=postgres
DB_PASSWORD=change-me-locally

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@example.com

CORS_ORIGINS=http://localhost:3001
